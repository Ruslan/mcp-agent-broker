# Agent Task Broker — environment.
#
# Copy to `.env` (gitignored) and fill in. This file documents the NAMES; the real
# host names, domains and keys belong in `.env` only, never in a committed file.
#
#   cp .env.example .env && $EDITOR .env
#
# `.env` serves two consumers:
#   1. the broker process itself — main.go's loadDotEnv() reads it when you `make run`;
#   2. Kamal — `make kamal <words>` include+export's it, so config/deploy.yml's ERB
#      lookups and .kamal/secrets resolve. (Kamal never reads .env on its own.)

# --- application ------------------------------------------------------------

# Port the broker listens on (also the port kamal-proxy connects to).
PORT=9197

# SQLite database. Locally a repo-relative path is fine; in the container this is
# overridden to /data/broker.db (the Kamal volume) by config/deploy.yml.
DB_PATH=data/broker.db

# Directory of role prompt files (coder.md, reviewer.md, …).
PROMPTS_DIR=prompts

# Master API key for /rpc and /admin. Empty = NO AUTHENTICATION (fine on a laptop,
# never on a public host). GET /health, GET /poll/{token} and GET /skill/install stay
# open by design regardless.
#   generate one: openssl rand -hex 32
API_KEY=

# Absolute public base url of this broker, e.g. https://broker.example.com — it is
# stamped into the capability poll_urls handed to agents, so it must be the address
# THEY can reach. Leave empty for local runs.
BROKER_PUBLIC_URL=

# Trust X-Forwarded-Proto/Host when deriving urls. Enable only behind a reverse proxy
# you control (kamal-proxy sets them); a directly-exposed broker must leave it false.
BROKER_TRUST_FORWARDED=false

# Feature flags: sync tools (await_task, listen_role wait) / async tools (poll).
ENABLE_SYNC=true
ENABLE_ASYNC=true

# --- deployment (Kamal) -----------------------------------------------------
# Only needed on the machine you deploy FROM.

# Target server: the IP or hostname Kamal ssh's into.
KAMAL_SERVER_IP=

# Account Kamal ssh's in as on that server. It needs docker access — either root, or
# a user in the `docker` group. Required; there is no default.
KAMAL_SSH_USER=

# Public domain kamal-proxy routes to this app by Host header.
BROKER_HOST=

# true  → kamal-proxy fetches a Let's Encrypt certificate itself.
# false → TLS terminated upstream; the proxy speaks plain HTTP to this app.
BROKER_PROXY_SSL=true

# Image registry. Either a public one (ghcr.io / docker.io) with credentials, or a
# registry on the deploy host (e.g. localhost:5000) with both credentials left empty.
KAMAL_REGISTRY_SERVER=
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=

# Optional overrides: Kamal service name (also the volume prefix), image name, and
# the architecture the image is built for.
# KAMAL_SERVICE=agent-broker
# KAMAL_IMAGE=agent-broker/broker
# KAMAL_BUILD_ARCH=amd64
